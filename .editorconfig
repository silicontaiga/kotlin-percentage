root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Matches kotlin.code.style=official in gradle.properties, so IntelliJ's formatter
# and ktlint agree instead of undoing each other. (ktlint's own `ktlint_official`
# style is explicitly documented as incompatible with the IDE formatters.)
ktlint_code_style = intellij_idea
max_line_length = 140
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[src/test/kotlin/**.kt]
# A Kotest spec is `class FooTest : FunSpec({ … })`. Because the lambda is
# multiline, the class-signature rule wants the supertype on its own line, which
# mangles the idiom for every spec in the suite.
ktlint_standard_class-signature = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[gradlew.bat]
end_of_line = crlf
